<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Ex2App">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Example 2: MVC Counter" />
      <Label fx:id="countLabel" styleClass="counter-label" text="Count: 0" />
      <CheckBox fx:id="checkBox" mnemonicParsing="false" text="Did the thing" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button onAction="#handleIncrement" text="Count (+1)" />
            <Button onAction="#handleReset" styleClass="reset-button" text="Reset" />
         </children>
      </HBox>
   </children>
</VBox>
